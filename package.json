{
  "name": "cricket-chat-backend",
  "version": "1.0.3",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "demo": "node scripts/demo-transcript.js",
    "test": "npm run test:cases && npm run test:integration",
    "test:cases": "node scripts/test-cases.js",
    "test:integration": "node --test tests/*.test.js",
    "verify": "npm test && npm audit --omit=dev",
    "test:cricapi": "node scripts/test-cricapi.js",
    "dataset:clean": "python scripts/build_clean_dataset.py",
    "chroma:build": "python scripts/build_chroma_local.py --reset",
    "rebuild:all": "python scripts/build_chroma_local.py --reset",
    "chroma:query": "python scripts/query_chroma_local.py"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "chromadb": "^3.4.3",
    "cors": "^2.8.5",
    "espn-cricket-api": "^1.0.4",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.3"
  }
}
